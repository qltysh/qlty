 "text": "#!/usr/bin/env python3\n\"\"\"Walk a tree of records and count the deep matches.\"\"\"\nimport sys\n\n\ndef count(records, limit):\n    total = 0\n    for record in records:\n        for group in record[\"groups\"]:\n            for item in group:\n                if item[\"kind\"] == \"match\":\n                    if item[\"score\"] > limit:\n                        if item[\"flag\"] or item[\"other\"] or item[\"third\"] or item[\"fourth\"] or item[\"fifth\"]:\n                            total += 1\n    return total\n\n\nif __name__ == \"__main__\":\n    print(count([], int(sys.argv[1])))\n",

 "text": "pub fn deep(items: &[Vec<Option<i32>>], limit: i32) -> i32 {\n    let mut total = 0;\n    for row in items {\n        for item in row {\n            if let Some(value) = item {\n                if *value > limit {\n                    while total < *value {\n                        if total % 2 == 0 {\n                            total += 3;\n                        } else {\n                            total += 1;\n                        }\n                    }\n                }\n            }\n        }\n    }\n    total\n}\n\npub fn many_params(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32) -> i32 {\n    a + b + c + d + e + f + g\n}\n\npub fn many_returns(value: i32) -> &'static str {\n    if value == 0 {\n        return \"zero\";\n    }\n    if value == 1 {\n        return \"one\";\n    }\n    if value == 2 {\n        return \"two\";\n    }\n    if value == 3 {\n        return \"three\";\n    }\n    if value == 4 {\n        return \"four\";\n    }\n    if value == 5 {\n        return \"five\";\n    }\n    \"many\"\n}\n",

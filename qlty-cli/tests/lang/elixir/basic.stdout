      "snippet": "def price(order) do/n    subtotal = order.quantity * order.unit_price/n    discount = subtotal * order.discount_rate/n    taxable = subtotal - discount/n    tax = taxable * order.tax_rate/n    shipping = order.shipping_base + order.weight * order.shipping_rate/n    handling = order.handling_base/n    total = taxable + tax + shipping + handling/n    rounded = Float.round(total, 2)/n/n    %{/n      subtotal: subtotal,/n      discount: discount,/n      taxable: taxable,/n      tax: tax,/n      shipping: shipping,/n      handling: handling,/n      total: total,/n      rounded: rounded/n    }/n  end",

---
source: qlty-cli/src/format/sarif.rs
expression: json_value
---
{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "qlty",
          "informationUri": "https://github.com/qltysh/qlty",
          "semanticVersion": "[version]",
          "version": "[version_string]",
          "releaseDateUtc": "[date]",
          "rules": [
            {
              "id": "test-tool:test-rule-1",
              "helpUri": "https://example.com/docs/test-rule-1"
            },
            {
              "id": "test-tool:test-rule-2"
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [
            {
              "level": "note",
              "message": {
                "text": "Info message\n\nDetailed info"
              },
              "descriptor": {
                "id": "qlty:message:INFO"
              }
            },
            {
              "level": "warning",
              "message": {
                "text": "Warning message"
              },
              "descriptor": {
                "id": "qlty:message:WARNING"
              }
            }
          ]
        }
      ],
      "columnKind": "utf16CodeUnits",
      "results": [
        {
          "ruleId": "test-tool:test-rule-1",
          "level": "error",
          "message": {
            "text": "Test message 1"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/test.rs"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 5,
                  "endLine": 10,
                  "endColumn": 20,
                  "sourceLanguage": "rust"
                }
              }
            }
          ],
          "partialFingerprints": {
            "sourceHash/1": "abc123def456"
          },
          "relatedLocations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/related.rs"
                },
                "region": {
                  "startLine": 20,
                  "startColumn": 3,
                  "endLine": 22,
                  "endColumn": 10
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/related2.rs"
                },
                "region": {
                  "startLine": 30,
                  "startColumn": 1,
                  "endLine": 35,
                  "endColumn": 2
                }
              }
            }
          ],
          "taxa": [
            {
              "id": "vulnerability"
            }
          ],
          "properties": {
            "tags": [
              "test-tag",
              "security",
              "critical"
            ]
          }
        },
        {
          "ruleId": "test-tool:test-rule-2",
          "level": "warning",
          "message": {
            "text": "Test message 2"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/test2.rs"
                },
                "region": {
                  "startLine": 15,
                  "startColumn": 1,
                  "endLine": 20,
                  "endColumn": 2,
                  "sourceLanguage": "typescript"
                }
              }
            }
          ],
          "taxa": [
            {
              "id": "lint"
            }
          ]
        }
      ]
    }
  ]
}
